{
  "mcpServers": {
    "contextbase": {
      "command": "C:/Program Files/nodejs/node.exe",
      "args": [
        "C:/Users/TOOR/AppData/Roaming/npm/node_modules/contextbase/bin/contextbase.js",
        "mcp"
      ],
      "alwaysAllow": [
        "contextbase_status",
        "contextbase_context",
        "contextbase_log",
        "contextbase_task",
        "contextbase_sync",
        "contextbase_audit",
        "contextbase_swarm_start",
        "contextbase_swarm_status",
        "contextbase_swarm_send",
        "contextbase_swarm_collect",
        "contextbase_swarm_stop"
      ]
    }
  }
}
